        /* ===== NOTICE: scroll + blink (text turant right edge se aata hai) ===== */
        .notice-bar { display: flex; align-items: stretch; height: 34px; overflow: hidden; }
        .notice-marquee {
            flex: 1 1 auto;
            position: relative !important;
            display: block !important;
            overflow: hidden;
            padding: 0 !important;
            white-space: nowrap;
        }
        .notice-track {
            position: absolute !important;
            top: 0;
            left: 100%;
            display: block !important;
            padding: 0 !important;
            white-space: nowrap;
            line-height: 34px;
            animation: notice-run 35s linear infinite !important;
        }
        .notice-marquee:hover .notice-track { animation-play-state: paused; }
        .blinking-label {
            color: #C5122F;
            font-size: 14px;
            font-weight: bold;
            white-space: nowrap;
            animation: blink 1.2s ease-in-out infinite;
        }
        @keyframes notice-run {
            0%   { left: 100%; transform: translateX(0); }
            100% { left: 0;    transform: translateX(-100%); }
        }

        /* ===== PROFILE DROPDOWN (photo ke neeche, center) ===== */
        .profile-box ul.dropdown-menu {
            display: none;
            position: absolute !important;
            top: 100% !important;
            left: 50% !important;
            right: auto !important;
            transform: translateX(-50%);
            float: none !important;
            margin: 10px 0 0 !important;
            padding: 6px 0 !important;
            min-width: 190px;
            list-style: none;
            text-align: left;
            background: #fff !important;
            border: 1px solid #f0d2ab !important;
            border-top: 3px solid #C5122F !important;
            border-radius: 10px !important;
            box-shadow: 0 10px 24px rgba(0,0,0,.28) !important;
            z-index: 10000;
        }
        .profile-box ul.dropdown-menu::before {      /* hover gap bridge */
            content: ""; position: absolute; top: -16px; left: 0; right: 0; height: 16px;
        }
        .profile-box ul.dropdown-menu::after {       /* upar ka tikona */
            content: ""; position: absolute; top: -10px; left: 50%; margin-left: -7px;
            border: 7px solid transparent; border-top: 0; border-bottom: 7px solid #C5122F;
        }
        .profile-box li.dropdown:hover > ul.dropdown-menu,
        .profile-box li.dropdown.open > ul.dropdown-menu { display: block !important; animation: profileIn .18s ease-out; }
        .profile-box ul.dropdown-menu li { list-style: none; margin: 0; padding: 0; float: none; width: 100%; }
        .profile-box ul.dropdown-menu li.divider { height: 1px; margin: 4px 12px; background: #f1e3d0; overflow: hidden; width: auto; }
        .profile-box ul.dropdown-menu li a {
            display: block; position: relative;
            padding: 10px 18px 10px 44px;
            font: 600 13px/18px "Segoe UI", Arial, sans-serif;
            color: #333 !important;
            text-decoration: none !important;
            white-space: nowrap;
            border-left: 3px solid transparent;
            background: transparent !important;
            transition: all .18s ease;
        }
        .profile-box ul.dropdown-menu li a::before {
            font-family: FontAwesome; font-weight: normal; font-size: 15px;
            position: absolute; left: 17px; top: 50%; transform: translateY(-50%);
            width: 18px; text-align: center; color: #ed7600;
        }
        .profile-box ul.dropdown-menu li a[id$="lnkChangePassword1"]::before { content: "\f084"; }  /* key */
        .profile-box ul.dropdown-menu li a[id$="lnkLogOut"]::before           { content: "\f08b"; }  /* sign-out */
        .profile-box ul.dropdown-menu li a:hover {
            background: linear-gradient(90deg, #fff0dc, #ffffff) !important;
            color: #C5122F !important;
            border-left-color: #ed7600;
        }
        .profile-box ul.dropdown-menu li a:hover::before { color: #C5122F; }

        @keyframes profileIn {
            from { opacity: 0; transform: translateX(-50%) translateY(8px); }
            to   { opacity: 1; transform: translateX(-50%) translateY(0); }
        }

        /* ===== DROPDOWN LINES: sab ek jaisi patli ===== */
        /* li ka apna koi border/background/padding nahi (purani CSS ki moti lines hatane ke liye) */
        #menu ul.dropdown-menu li {
            border: 0 !important;
            box-shadow: none !important;
            background: transparent !important;
            background-image: none !important;
            padding: 0 !important;
            min-height: 0 !important;
            line-height: normal !important;
        }
        /* jis li mein koi link hi nahi (server se hide hua link ya khaali li) use hata do */
        #menu ul.dropdown-menu li:not(:has(a)) { display: none !important; }
        /* line sirf link ke neeche, ek jaisi 1px halki */
        #menu ul.dropdown-menu li > a {
            border-bottom: 1px solid #f1e3d0 !important;
            border-top: 0 !important;
            border-right: 0 !important;
            box-shadow: none !important;
        }
        #menu ul.dropdown-menu li:last-child > a { border-bottom: 0 !important; }
    </style>

     <script type="text/javascript">
         function callFeedbackMessage(inputType, inputText) {

             if (inputType == 'Error') {
                 alertify.error(inputText);
                 return false;
             }
             else if (inputType == 'Success') {
                 alertify.success(inputText);
                 return false;
             }
             else {
                 alertify.log(inputText, "", 10000);
                 return false;
             }
         }
     </script>
    <script type ="text/javascript">
        var validFilesTypes = ["bmp", "png", "jpg", "jpeg", "gif"];
        function ValidateFile() {
            var label;
            var path = $('[id$=imgUpload]').val();
            var ext = path.substring(path.lastIndexOf(".") + 1, path.length).toLowerCase();
            var isValidFile = false;
            for (var i = 0; i < validFilesTypes.length; i++) {
                if (ext == validFilesTypes[i]) {
                    isValidFile = true;
                }
            }
            if (!isValidFile) {

                label = "Invalid File. Please upload a File with" +
                    " extension:\n\n" + validFilesTypes.join(", ");
                alertify.error(label);
            }
            return isValidFile;
        }

        $(document).ready(function () {
            $('[id$=btnChangePassword]').click(function Save() {
                $('[id$=txtOldPassword]').val() == '';
                $('[id$=txtNewPassword]').val() == '';
                $('[id$=txtConfirmPassword]').val() == '';
                $('[id$=lblErrorMessage]').text('');
                var a = '', b = '', c = '';
                $('[id$=txtOldPassword]').css('border-color', 'red');
                if ($('[id$=txtOldPassword]').val() == '') { a = "false" } else $('[id$=txtOldPassword]').css('border-color', '');
                $('[id$=txtNewPassword]').css('border-color', 'red');
                if ($('[id$=txtNewPassword]').val() == '') { a = "false" } else $('[id$=txtNewPassword]').css('border-color', '');
                $('[id$=txtConfirmPassword]').css('border-color', 'red');
                if ($('[id$=txtConfirmPassword]').val() == '') { a = "false" } else $('[id$=txtConfirmPassword]').css('border-color', '');

                if ($('[id$=txtNewPassword]').val() != $('[id$=txtConfirmPassword]').val()) { b = "false" };

                if ($('[id$=txtNewPassword]').val().length < 5) { c = "false" };

                if (a == "false") { return false; }
                if (c == "false") {
                    $('[id$=lblErrorMessage]').text('Password must be at least 5 characters!');
                    return false;
                }
                if (b == "false") {
                    $('[id$=lblErrorMessage]').text('Password does not match the confirm password!');
                    return false;
                }

                var arr = { txtOldPassword: $('[id$=txtOldPassword]').val(), txtNewPassword: $('[id$=txtNewPassword]').val() };
                $.ajax({
                    type: "POST",
                    url: "MasterPageChanges.aspx/ChangePassword",
                    data: JSON.stringify(arr),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: ChangePassword,
                    error: function (xmlHttpRequest, textStatus, errorThrown) {
                        alert('Error');
                    }
                });
            });
        });
        function ChangePassword(data) {
            if (data.d == 'successfully') {
                alertify.success('Change password successfully');
            }
            else {
                alertify.error('Old Password in not correct');
            }
        }

        function Startblink() {
            var lbl = document.getElementById('Label1');
            lbl.style.textDecoration = 'blink';
        }
    </script>

</head>
