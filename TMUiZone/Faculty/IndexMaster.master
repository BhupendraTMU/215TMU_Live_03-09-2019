:root {
    --tmu-orange: #ed7600;
    --tmu-orange-light: #f7a23b;
    --tmu-orange-dark: #c95f00;
    --tmu-red: #C5122F;
}

/* ---------- Top strips ---------- */
.top-user-label {
    text-align: right;
    padding: 3px 18px;
    font-size: 12px;
    font-weight: bold;
    color: var(--tmu-red);
    background: #fff;
}
.top-red-line  { height: 3px; background: linear-gradient(90deg, #C5122F, #ed7600); }
.top-white-gap { height: 0; }

/* ---------- Header ---------- */
.header-wrap-bg {
    background: linear-gradient(180deg, #ffffff 0%, #fff6ea 100%);
    border-bottom: 1px solid #f3d3a8;
}
#wrapHeader {
    width: 1300px;
    max-width: 100%;
    margin: 0 auto;
    padding: 6px 20px;
    box-sizing: border-box;
}
.header-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}
.header-logo img {
    height: 62px;            /* chota logo */
    width: auto;
    display: block;
}
.header-actions {
    display: flex;
    align-items: center;
    gap: 24px;
}
.mark-att-link {
    font-size: 16px;
    font-weight: bold;
    color: #fff !important;
    background: var(--tmu-red);
    padding: 7px 16px;
    border-radius: 20px;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(197,18,47,.35);
}
.mark-att-link:hover { background: #a30f27; }

/* ---------- Profile (chota, side-by-side) ---------- */
.profile-box {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: left;
}
.profile-box ul { list-style: none; margin: 0; padding: 0; }
.profile-box .dropdown { position: relative; list-style: none; }

.imgcircle {
    width: 54px;
    height: 54px;            /* chota profile pic */
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px var(--tmu-orange), 0 3px 8px rgba(0,0,0,.25);
    cursor: pointer;
    display: block;
    transition: transform .2s ease;
}
.imgcircle:hover { transform: scale(1.06); }

.profile-info { display: flex; flex-direction: column; }
.profile-name {
    font-size: 13px;
    font-weight: bold;
    color: #2b2b2b;
    line-height: 1.2;
    text-transform: uppercase;
}
.profile-status {
    display: inline-block;
    margin-top: 3px;
    font-size: 11px;
    font-weight: bold;
    color: #9a4a00;
    background: #ffe9cc;
    border: 1px solid #f7c98f;
    border-radius: 12px;
    padding: 1px 10px;
    width: auto !important;
}

/* ---------- Notice ticker ---------- */
.notice-bar {
    display: flex;
    align-items: stretch;
    background: #fff;
    border-bottom: 1px solid #f3d3a8;
    height: 32px;
    overflow: hidden;
}
.notice-badge {
    flex: 0 0 auto;
    background: var(--tmu-red);
    color: #fff;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: .5px;
    padding: 0 16px 0 18px;
    line-height: 32px;
    position: relative;
    z-index: 2;
    clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
}
.notice-badge i { margin-right: 6px; }
.notice-marquee {
    flex: 1 1 auto;
    overflow: hidden;
    white-space: nowrap;
    line-height: 32px;
    background: linear-gradient(90deg, #fff4e5, #ffffff);
}
.notice-track {
    display: inline-block;
    padding-left: 100%;
    animation: notice-scroll 30s linear infinite;
}
.notice-marquee:hover .notice-track { animation-play-state: paused; }

.blinking-label {
    color: var(--tmu-red);
    font-size: 14px;
    font-weight: bold;
    white-space: nowrap;
    animation: blink 1.2s ease-in-out infinite;
}
@keyframes notice-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-100%); }
}
@keyframes blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: .3; }
}

/* ---------- Orange menu bar ---------- */
.menu-row {
    background: linear-gradient(180deg, var(--tmu-orange-light) 0%, var(--tmu-orange) 55%, var(--tmu-orange-dark) 100%);
    box-shadow: 0 2px 6px rgba(0,0,0,.25);
}
#wrapMenu {
    width: 1300px;
    max-width: 100%;
    margin: 0 auto;
}
#menu > li > a { transition: background .2s ease; }
#menu > li > a:hover { background: rgba(0,0,0,.15); }

/* ---------- Info strip (Form-16) ---------- */
.info-strip {
    height: 26px;
    line-height: 26px;
    text-align: center;
    color: var(--tmu-red);
    font-size: 13px;
    font-weight: bold;
    background: #fff;
    border-bottom: 1px solid #eee;
}

/* ---------- Footer ---------- */
.ffooterInner {
    background: linear-gradient(180deg, var(--tmu-orange) 0%, var(--tmu-orange-dark) 100%);
    opacity: 1 !important;
}
#wrapFooter {
    width: 1300px;
    max-width: 100%;
    margin: 0 auto;
    padding: 8px 20px;
    box-sizing: border-box;
    color: #fff;
    opacity: 1 !important;
}
#wrapFooter, #wrapFooter * { opacity: 1 !important; }
#wrapFooter label,
#wrapFooter span,
#wrapFooter a {
    color: #fff !important;
    text-shadow: 0 1px 1px rgba(0,0,0,.35);
}
#wrapFooter a:hover { text-decoration: underline !important; }
.footer-note {
    font-size: 13px;
    font-weight: bold;
}

/* ---------- Mobile ---------- */
@media (max-width: 768px) {
    .header-flex { flex-direction: column; text-align: center; }
    .header-logo img { height: 50px; }
    .profile-box { justify-content: center; }
    .notice-track { animation-duration: 20s; }
}
html, body { min-height: 100%; }
body { background-color: #eaf3b0; }

/* Content ka safed dabba footer tak */
#wrap {
    width: 1300px;
    max-width: 100%;
    margin: 0 auto;
    background-color: #fff;
    box-sizing: border-box;
    /* header+menu (~202px) + neeche footer ke liye gap (52px) chhod kar baaki poori height */
    min-height: calc(100vh - 258px) !important;
}

         /* ===== MenuFancy.css (v2 - self-contained menu system) =====
   Link: <link href="../CSS/MenuFancy.css" rel="stylesheet" type="text/css" />
   IndexMasterFix.css ke BAAD, sabse last mein.
   Ye file dropdown ka show/hide khud handle karti hai (hover se).
*/

/* ================= TOP BAR ================= */
#menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
}
#menu > li {
    float: none !important;
    position: relative;
    margin: 0 !important;
    padding: 0;
    list-style: none;
}
#menu a:focus { outline: none !important; }

#menu > li > a {
    display: flex !important;
    align-items: center;
    gap: 6px;
    color: #fff !important;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .4px;
    line-height: 20px;
    padding: 8px 14px !important;
    margin: 4px 2px;
    border: none !important;
    border-radius: 6px;
    text-decoration: none !important;
    text-shadow: 0 1px 1px rgba(0,0,0,.35);
    background: transparent;
    transition: background .2s ease, box-shadow .2s ease;
}
#menu > li > a > i.fa {
    font-size: 15px;
    transition: transform .2s ease;
}
#menu > li > a b { font-weight: 700; }
#menu > li:hover > a {
    background: rgba(255,255,255,.22) !important;
    box-shadow: inset 0 -3px 0 #fff;
}
#menu > li:hover > a > i.fa { transform: translateY(-2px) scale(1.15); }
#menu .sf-sub-indicator { font-size: 12px; margin-left: 2px; }

/* ================= DROPDOWN PANEL ================= */
#menu ul.dropdown-menu {
    display: none !important;              /* default band */
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    float: none !important;
    height: auto !important;
    max-height: none !important;
    overflow: visible !important;
    width: max-content;
    min-width: 260px;
    max-width: 360px;
    margin: 0 !important;
    padding: 6px 0 !important;
    list-style: none;
    text-align: left;
    background: #fff !important;
    border: 1px solid #f0d2ab !important;
    border-top: 3px solid #C5122F !important;
    border-radius: 0 0 10px 10px !important;
    box-shadow: 0 12px 28px rgba(0,0,0,.30) !important;
    z-index: 9999;
}
#menu li:hover > ul.dropdown-menu {
    display: block !important;             /* hover par open */
    animation: menuIn .18s ease-out;
}
@keyframes menuIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* andar ke (nested) flyout menu -> right side */
#menu ul.dropdown-menu ul.dropdown-menu {
    top: -9px !important;
    left: 100% !important;
    border-top: 3px solid #ed7600 !important;
    border-radius: 10px !important;
}

/* lambe menu ko multi-column (sab kuch screen par dikhe) */
#menu li:has(> a[id$="liOthers"]) > ul.dropdown-menu {
    column-count: 3;
    column-gap: 0;
    width: 800px;
    min-width: 0;
    max-width: none;
    left: -380px !important;
}
#menu li:has(> a[id$="liHR"]) > ul.dropdown-menu {
    column-count: 2;
    column-gap: 0;
    width: 560px;
    min-width: 0;
    max-width: none;
    left: -120px !important;
}
/* multi-column ke andar ke flyout ki width normal rahe */
#menu ul.dropdown-menu ul.dropdown-menu {
    column-count: 1 !important;
    width: max-content !important;
    min-width: 240px !important;
    max-width: 340px !important;
    left: 100% !important;
}
#menu ul.dropdown-menu > li { break-inside: avoid; }

/* clearfix: floated links ki wajah se box collapse na ho */
#menu ul.dropdown-menu::after,
#menu ul.dropdown-menu li::after { content: ""; display: table; clear: both; }

/* ================= DROPDOWN ITEMS ================= */
#menu ul.dropdown-menu li {
    position: relative;
    float: none !important;
    display: block !important;
    height: auto !important;
    width: 100%;
    margin: 0 !important;
    padding: 0;
    list-style: none;
}
#menu ul.dropdown-menu li a {
    display: block !important;
    float: none !important;
    width: auto !important;
    height: auto !important;
    white-space: normal;
    box-sizing: border-box;
    position: relative;
    color: #333 !important;
    background: transparent !important;
    font-size: 13px;
    font-weight: 600;
    line-height: 18px;
    text-transform: none;
    text-decoration: none !important;
    text-shadow: none;
    padding: 9px 16px 9px 42px !important;
    border-bottom: 1px solid #f6efe6;
    border-left: 3px solid transparent;
    transition: all .18s ease;
}
#menu ul.dropdown-menu li a b { font-weight: 600; }
#menu ul.dropdown-menu li:hover > a {
    background: linear-gradient(90deg, #fff0dc, #ffffff) !important;
    color: #C5122F !important;
    border-left-color: #ed7600;
    padding-left: 47px !important;
}
#menu ul.dropdown-menu .sf-sub-indicator {
    float: right;
    color: #ed7600;
    font-size: 14px;
}

/* ================= SUBMENU ICONS ================= */
#menu ul.dropdown-menu li a::before {
    font-family: FontAwesome;
    font-weight: normal;
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    text-align: center;
    color: #ed7600;
    font-size: 14px;
    transition: transform .18s ease;
    content: "\f105";
}
#menu ul.dropdown-menu li:hover > a::before { color: #C5122F; transform: translateY(-50%) scale(1.25); }

#menu ul.dropdown-menu a[href*="Attendance"]::before,
#menu ul.dropdown-menu a[href*="Attendence"]::before   { content: "\f274"; }
