                            </div>
                        </div>
                        <div class="modal-footer" style="border-top-width: 0px">
                            <asp:Button runat="server" ID="btnChangeImage" OnClientClick="return ValidateFile()" OnClick="btnChangeImage_Click" CssClass="btn btn-primary" ValidationGroup="g4" Text="Change Image"></asp:Button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>

    <script type="text/javascript">
        (function () {
            var toggle = document.getElementById('tmuNavToggle');
            var menu = document.getElementById('tmuMenu');
            if (toggle && menu) {
                // Menu 2 rows me: upar 8 items, baaki niche
                var ROW1 = 8;
                var menu2 = document.createElement('ul');
                menu2.className = 'tmu-menu tmu-menu2';
                menu2.id = 'tmuMenu2';
                var top = [];
                for (var k = 0; k < menu.children.length; k++) top.push(menu.children[k]);
                for (var j = ROW1; j < top.length; j++) menu2.appendChild(top[j]);
                if (menu2.children.length > 0) menu.parentNode.appendChild(menu2);

                toggle.onclick = function () {
                    var open = menu.className.indexOf('show') > -1;
                    menu.className = open ? 'tmu-menu' : 'tmu-menu show';
                    menu2.className = open ? 'tmu-menu tmu-menu2' : 'tmu-menu tmu-menu2 show';
                };
                var items = [];
                var l1 = menu.getElementsByTagName('li'), l2 = menu2.getElementsByTagName('li');
                for (var m = 0; m < l1.length; m++) items.push(l1[m]);
                for (var n = 0; n < l2.length; n++) items.push(l2[n]);
                for (var i = 0; i < items.length; i++) {
                    (function (li) {
                        var a = li.children[0];
                        var sub = li.children[1];
                        if (a && sub && sub.className.indexOf('tmu-sub') > -1) {
                            a.onclick = function (e) {
                                if (window.innerWidth <= 900) {
                                    e = e || window.event;
                                    if (e.preventDefault) e.preventDefault();
                                    li.className = (li.className.indexOf('open') > -1) ? '' : 'open';
                                    return false;
                                }
                            };
                        }
                    })(items[i]);
                }
            }
        })();
    </script>
</body>
</html>
