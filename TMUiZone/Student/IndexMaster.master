            <!-- Change Password modal -->
            <div class="modal fade tmu-modal" id="myModal" role="dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                            <h4 class="modal-title"><i class="fa fa-lock"></i>&nbsp; Change Password</h4>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <asp:Label ID="Label28" runat="server" CssClass="tmu-lbl" Text="Old Password:"></asp:Label>
                                <div class="input-group">
                                    <span class="input-group-addon"><span class="glyphicon glyphicon-education"></span></span>
                                    <asp:TextBox runat="server" TextMode="Password" ID="txtOldPassword" CssClass="form-control input-sm" Height="34px"></asp:TextBox>
                                </div>
                                <asp:RequiredFieldValidator ID="RequiredFieldValidator3" runat="server" Display="Dynamic" ForeColor="Red" ErrorMessage="Please input the old password!" ControlToValidate="txtOldPassword" ValidationGroup="g3"></asp:RequiredFieldValidator>
                            </div>
                            <div class="form-group">
                                <asp:Label ID="Label2" runat="server" CssClass="tmu-lbl" Text="New Password:"></asp:Label>
                                <div class="input-group">
                                    <span class="input-group-addon"><span class="glyphicon glyphicon-education"></span></span>
                                    <asp:TextBox runat="server" TextMode="Password" ID="txtNewPassword" CssClass="form-control input-sm" Height="34px"></asp:TextBox>
                                </div>
                                <asp:RequiredFieldValidator ID="RequiredFieldValidator2" runat="server" Display="Dynamic" ForeColor="Red" ErrorMessage="Please input the new password!" ControlToValidate="txtNewPassword" ValidationGroup="g3"></asp:RequiredFieldValidator>
                            </div>
                            <div class="form-group">
                                <asp:Label ID="Label3" runat="server" CssClass="tmu-lbl" Text="Confirm Password:"></asp:Label>
                                <div class="input-group">
                                    <span class="input-group-addon"><span class="glyphicon glyphicon-education"></span></span>
                                    <asp:TextBox runat="server" TextMode="Password" ID="txtConfirmPassword" CssClass="form-control input-sm" Height="34px"></asp:TextBox>
                                </div>
                                <asp:RequiredFieldValidator ID="RequiredFieldValidator1" runat="server" Display="Dynamic" ForeColor="Red" ErrorMessage="Please input the confirm password!" ControlToValidate="txtConfirmPassword" ValidationGroup="g3"></asp:RequiredFieldValidator>
                                <asp:CompareValidator ID="CompareValidator1" runat="server" ControlToCompare="txtNewPassword" ControlToValidate="txtConfirmPassword" ErrorMessage="The password does not match!" ForeColor="Red" ValidationGroup="g3"></asp:CompareValidator>
                            </div>
                        </div>
                        <div class="modal-footer" style="border-top-width: 0px">
                            <asp:Button runat="server" ID="btnChangePassword" CssClass="btn btn-primary" OnClick="btnChangePassword_Click" ValidationGroup="g3" Text="Change"></asp:Button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Upload Image modal -->
            <div class="modal fade tmu-modal" id="myModal1" role="dialog">
