<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>TMU</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="../CSS/Amizone.css" rel="stylesheet" type="text/css" />
    <link href="../CSS/Style.css" rel="stylesheet" type="text/css" />
    <link href="../CSS/maincss.css" rel="stylesheet" type="text/css" />
    <link href="../CSS/ajaxtabs.css" rel="stylesheet" type="text/css" />

    <script src="../Scripts/ajaxtabs.js"></script>
    <script src="../Scripts/jquery-1.4.1-vsdoc.js"></script>

    <script src="../Scripts/jquery-1.4.1.js"></script>
    <script src="../Scripts/jquery-1.4.1.min.js"></script>
    <link href="../CSS/Ajaxcal.css" rel="stylesheet" />
    <script type="text/javascript" src="../bootstrap/js/jquery-1.11.2.min.js"></script>
    <link href="../bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <script type="text/javascript" src="../bootstrap/js/bootstrap.min.js"></script>
    <link href="../dropdown_one.css" rel="stylesheet" />
    <link href="../CSS/mainpage.css" rel="stylesheet" type="text/css" />
    <link href="../CSS/reset.css" rel="stylesheet" type="text/css" />
    <link href="../CSS/structure.css" rel="stylesheet" type="text/css" />
    <link rel="shortcut icon" type="image/x-icon" href="../logo/Bg.jpg" />

    <link href="../CSS/style.css" rel="stylesheet" />
    <script src="../Scripts/alertify.js"></script>
    <script src="../Scripts/alertify.min.js"></script>
    <link href="../Content/alertify/alertify.bootstrap.css" rel="stylesheet" />
    <link href="../Content/alertify/alertify.core.css" rel="stylesheet" />
    <link href="../Content/alertify/alertify.default.css" rel="stylesheet" />
    <link href="../CSS/responsive.css" rel="stylesheet" />
    <link href="../CSS/font-awesome.css" rel="stylesheet" />
    <!-- Font Awesome 4.7 (naye icons ke liye) -->
    <link href="css/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="menucss/styles.css" rel="stylesheet" />

    <!-- ===== New design (Faculty portal style) ===== -->
    <style type="text/css">
        :root {
            --tmu-orange: #f08a00;
            --tmu-orange-dark: #d86f00;
            --tmu-maroon: #7a1212;
            --tmu-navy: #093A62;
            --tmu-bg: #e9f1b8;
            --tmu-cream: #fff6e8;
            --tmu-border: #e6d9c6;
        }

        html, body.tmu-body {
            margin: 0;
            padding: 0;
            font-family: Georgia, "Times New Roman", serif;
            color: #333;
        }

        /* ===== Autumn background image (poori screen par fit) ===== */
        html {
            background: #fbeedd !important; /* image load na ho to bhi cream rahe */
        }

        body.tmu-body {
            background: transparent !important;
        }

            body.tmu-body::before {
                content: "";
                position: fixed; /* scroll par bhi image apni jagah rahe */
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: -1;
                pointer-events: none;
                background: #fbeedd url('../logo/bg_autumn3.png') no-repeat center bottom;
                -webkit-background-size: cover;
                background-size: cover; /* kheeche/stretch nahi hoti, poori screen bharti hai */
            }

        @media (max-width: 900px) {
            body.tmu-body::before {
                background-position: 20% bottom; /* mobile par cycle wala hissa dikhe */
            }
        }

        .tmu-wrap {
            width: 100%;
        }

        /* top strip */
        .tmu-topstrip {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 5px 24px;
            background: #fff;
            border-top: 3px solid var(--tmu-orange);
            border-bottom: 1px solid var(--tmu-border);
            font-size: 12px;
            font-weight: bold;
            color: var(--tmu-maroon);
        }

        /* header */
        .tmu-header {
            background: linear-gradient(90deg, #fffaf2 0%, #fff1dc 100%);
            border-bottom: 1px solid var(--tmu-border);
        }

        .tmu-header-in {
            max-width: 1400px;
            margin: 0 auto;
            padding: 8px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .tmu-logo img {
            max-width: 100%;
            height: 70px;
            width: auto !important;
            display: block;
        }

        .tmu-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .tmu-userinfo {
            text-align: left;
            line-height: 1.3;
        }

            .tmu-userinfo .tmu-name {
                font-size: 14px;
                font-weight: bold;
                color: #222;
                text-transform: uppercase;
                display: block;
            }

        .tmu-badge {
            display: inline-block;
            margin-top: 3px;
            padding: 2px 12px;
            font-size: 11px;
            font-weight: bold;
            color: #5a4a00;
            background: #fff3c4;
            border: 1px solid #e8d48a;
            border-radius: 12px;
        }

        .tmu-profile {
            position: relative;
        }

        .tmu-avatar {
            width: 60px !important;
            height: 60px !important;
            border-radius: 50%;
            object-fit: cover;
            background: #fff !important; /* white background */
            border: 3px solid #ffc266 !important; /* light orange border */
            box-shadow: 0 2px 8px rgba(0,0,0,.18);
            cursor: pointer;
            display: block;
            padding: 2px; /* photo aur border ke beech white gap */
            box-sizing: border-box;
            transition: transform .2s ease, box-shadow .2s ease;
        }
            /* click (dabate hi) halki badi */
            .tmu-avatar:active {
                transform: scale(1.12);
                box-shadow: 0 4px 14px rgba(240,138,0,.45);
            }

        .tmu-profile-menu {
            display: none;
            position: absolute;
            left: 0;
            top: 100%;
            min-width: 190px;
            margin: 6px 0 0;
            padding: 6px 0;
            list-style: none;
            background: #fff;
            border-radius: 8px;
            border-top: 3px solid var(--tmu-maroon);
            box-shadow: 0 8px 24px rgba(0,0,0,.2);
            z-index: 3000;
        }

        .tmu-profile:hover .tmu-profile-menu {
            display: block;
        }

        .tmu-profile-menu li a {
            display: block;
            padding: 9px 16px;
            font-size: 13px;
            font-weight: bold;
            color: #333;
            text-decoration: none;
        }

            .tmu-profile-menu li a:hover {
                background: #fff3e0;
                color: var(--tmu-orange-dark);
            }

        .tmu-profile-menu li.divider {
            height: 1px;
            margin: 4px 0;
            background: #eee;
        }

        /* nav */
        .tmu-nav {
            background: linear-gradient(180deg, #f79a1a 0%, #e57a00 100%);
            box-shadow: 0 2px 6px rgba(0,0,0,.25);
            position: relative;
            z-index: 2000;
        }

        .tmu-nav-toggle {
            display: none;
            width: 100%;
            padding: 10px 16px;
            background: transparent;
            border: 0;
            color: #fff;
            font-size: 15px;
            font-weight: bold;
            text-align: left;
        }

        .tmu-menu {
            max-width: 1500px;
            margin: 0 auto;
            padding: 0 10px;
            list-style: none;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
        }

            .tmu-menu > li {
                position: relative;
                margin: 0;
            }

                .tmu-menu > li > a {
                    display: flex !important;
                    align-items: center;
                    gap: 6px;
                    padding: 12px 11px;
                    color: #fff;
                    font-size: 12.5px;
                    font-weight: bold;
                    line-height: 1.2;
                    text-transform: uppercase;
                    text-decoration: none;
                    white-space: nowrap;
                    font-family: "Trebuchet MS", Verdana, sans-serif;
                }
            /* icon text ke bilkul beech me (aadha upar, aadha niche) */
            .tmu-menu i.fa {
                display: inline-block;
                width: 18px;
                height: 18px;
                line-height: 18px;
                font-size: 14px;
                text-align: center;
                vertical-align: middle;
                flex: 0 0 18px;
                margin: 0;
            }

            .tmu-menu > li:hover > a,
            .tmu-menu > li.open > a {
                background: rgba(255,255,255,.22);
                border-radius: 6px 6px 0 0;
            }

            .tmu-menu .tmu-ind {
                font-size: 13px;
                margin-left: 4px;
            }

        .tmu-sub {
            display: none;
            position: absolute;
            left: 0;
            top: 100%;
            min-width: 230px;
            padding: 6px 0;
            margin: 0;
            list-style: none;
            background: #fff;
            border-top: 3px solid var(--tmu-maroon);
            border-radius: 0 0 10px 10px;
            box-shadow: 0 10px 28px rgba(0,0,0,.25);
        }

        .tmu-menu > li:hover > .tmu-sub,
        .tmu-menu > li.open > .tmu-sub {
            display: block;
        }

        .tmu-menu .tmu-sub,
        .tmu-menu .tmu-sub li {
            background: #fff !important;
            float: none !important;
            margin: 0 !important;
            width: auto;
        }

            .tmu-menu .tmu-sub li a {
                display: flex !important;
                align-items: center;
                gap: 10px;
                padding: 10px 18px;
                background: #fff !important;
                color: #333 !important;
                font-size: 13px;
                font-weight: bold;
                line-height: 1.2;
                text-transform: none;
                text-decoration: none;
                white-space: nowrap;
                border-bottom: 1px solid #f1ebe2;
                font-family: "Trebuchet MS", Verdana, sans-serif;
            }

            .tmu-menu .tmu-sub li:last-child a {
                border-bottom: 0;
            }
        /* second row: right wale items ka submenu screen ke andar khule */
        .tmu-menu2 > li:nth-last-child(-n+3) > .tmu-sub {
            left: auto;
            right: 0;
        }

        .tmu-menu2 {
            padding-top: 0;
        }

        .tmu-menu .tmu-sub li a i.fa {
            color: var(--tmu-orange) !important;
        }

        .tmu-menu .tmu-sub li a:hover {
            background: #fff3e0 !important;
            color: var(--tmu-orange-dark) !important;
        }

        .tmu-count {
            display: inline-block;
            min-width: 18px;
            padding: 1px 5px;
            margin-left: 2px;
            font-size: 10px;
            line-height: 16px;
            text-align: center;
            color: #fff;
            background: #c8102e;
            border-radius: 9px;
            vertical-align: top;
        }

        /* ===== Fixes: menu vertical balance + solid white submenu ===== */
        .tmu-menu {
            align-items: stretch;
        }

            .tmu-menu > li {
                display: flex !important;
                align-items: center;
                float: none !important;
                height: 44px;
                margin: 0 !important;
                padding: 0 !important;
                line-height: 1 !important;
                opacity: 1 !important;
            }

                .tmu-menu > li > a {
                    height: 44px;
                    margin: 0 !important;
                    padding: 0 11px !important; /* upar-niche barabar */
                    line-height: 1 !important;
                    box-sizing: border-box;
                    align-items: center;
                    justify-content: center;
                }

                    .tmu-menu > li > a > span,
                    .tmu-menu > li > a > i,
                    .tmu-menu > li > a > .tmu-count {
                        position: static !important;
                        top: auto !important;
                        vertical-align: middle;
                        line-height: 1;
                    }

                .tmu-menu > li:hover > a,
                .tmu-menu > li.open > a {
                    border-radius: 6px 6px 0 0;
                }

            .tmu-menu .tmu-sub {
                top: 100% !important;
                background: #fff !important;
                background-image: none !important;
                opacity: 1 !important;
                filter: none !important;
                -webkit-backdrop-filter: none !important;
                backdrop-filter: none !important;
                visibility: visible;
                z-index: 5000 !important;
                overflow: hidden;
                height: auto;
            }

                .tmu-menu .tmu-sub li,
                .tmu-menu .tmu-sub li a {
                    opacity: 1 !important;
                    filter: none !important;
                    text-shadow: none !important;
                    height: auto !important;
                    background-color: #fff !important;
                }

                    .tmu-menu .tmu-sub li a:hover {
                        background-color: #fff3e0 !important;
                    }

        /* profile dropdown (photo ke niche) */
        .tmu-profile-menu {
            width: 200px;
            min-width: 200px !important;
            padding: 6px 0 !important;
            margin: 0 !important;
            background: #fff !important;
            float: none !important;
            z-index: 6000 !important;
        }

            .tmu-profile-menu li {
                display: block !important;
                float: none !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #fff !important;
                list-style: none;
            }

                .tmu-profile-menu li a {
                    display: flex !important;
                    align-items: center;
                    gap: 10px;
                    padding: 10px 16px !important;
                    margin: 0 !important;
                    background: #fff !important;
                    color: #333 !important;
                    font-family: "Trebuchet MS", Verdana, sans-serif !important;
                    font-size: 13px !important;
                    font-weight: bold !important;
                    line-height: 1.2 !important;
                    text-decoration: none !important;
                    border: 0 !important;
                }

                    .tmu-profile-menu li a i.fa {
                        width: 18px;
                        text-align: center;
                        font-size: 15px;
                        color: var(--tmu-orange);
                    }

                    .tmu-profile-menu li a:hover,
                    .tmu-profile-menu li a:focus {
                        background: #fff3e0 !important;
                        color: var(--tmu-orange-dark) !important;
                    }

                .tmu-profile-menu li.divider {
                    height: 1px !important;
                    margin: 4px 0 !important;
                    padding: 0 !important;
                    background: #eee !important;
                }
        /* photo aur dropdown ke beech gap na rahe (hover na toote) */
        .tmu-profile {
            padding-bottom: 6px;
            margin-bottom: -6px;
        }

        .tmu-profile-menu {
            top: 100% !important;
        }

        /* popups menu ke upar dikhe */
        .modal {
            z-index: 10050 !important;
        }

        .modal-backdrop {
            z-index: 10040 !important;
        }

        /* footer hamesha neeche fix: page chhota ho to bhi screen ke bottom par */
        html, body.tmu-body {
            height: 100%;
        }

        form#form1 {
            min-height: 100%;
            height: 100%;
            margin: 0;
        }

        .tmu-wrap {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .tmu-main {
            flex: 1 0 auto;
        }

        .tmu-footer {
            flex-shrink: 0;
            margin-top: auto;
        }

        /* content */
        .tmu-main {
            padding: 18px 12px 30px;
            min-height: 0;
        }

        .tmu-content {
            max-width: 1300px;
            margin: 0 auto;
            padding: 16px 22px 24px;
            background: #fff;
            border: 1px solid #e3e3e3;
            border-radius: 6px;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
        }

        /* footer */
        .tmu-footer {
            background: linear-gradient(180deg, #f79a1a 0%, #e57a00 100%);
            color: #fff;
            padding: 12px 24px;
            font-size: 13px;
            min-height: 44px;
            line-height: 20px;
            position: relative;
            z-index: 1;
        }

            .tmu-footer, .tmu-footer * {
                color: #fff;
            }

        .tmu-footer-in {
            max-width: 1300px;
            margin: 0 auto;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            flex-wrap: wrap;
            gap: 6px 24px;
        }

        .tmu-footer a {
            color: #fff;
            font-weight: bold;
            text-decoration: none;
        }

        /* modals */
        .tmu-modal .modal-content {
            border: 0;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 12px 40px rgba(0,0,0,.35);
        }

        .tmu-modal .modal-header {
            background: linear-gradient(90deg, #f79a1a, #e57a00);
            color: #fff;
            border-bottom: 0;
            padding: 12px 18px;
        }

            .tmu-modal .modal-header .close {
                color: #fff;
                opacity: .9;
                text-shadow: none;
            }

        .tmu-modal .modal-title {
            font-size: 16px;
            font-weight: bold;
            color: #fff;
        }

        .tmu-modal .modal-body {
            padding: 20px 22px;
        }

        .tmu-modal .tmu-lbl {
            font-size: 13px;
            font-weight: bold;
            color: #444;
            margin-bottom: 4px;
            display: block;
        }

        @media (max-width: 900px) {
            .tmu-header-in {
                flex-direction: row; /* column ki jagah row: side-by-side */
                flex-wrap: nowrap;
                justify-content: space-between;
                align-items: center;
                padding: 8px 10px;
                gap: 8px;
            }

            .tmu-logo {
                flex: 1 1 auto;
                min-width: 0; /* logo chhota ho sake */
            }

                .tmu-logo img {
                    height: auto;
                    max-height: 55px;
                    max-width: 100%;
                }

            .tmu-user {
                flex: 0 0 auto;
                gap: 8px;
            }

            .tmu-avatar {
                width: 46px !important;
                height: 46px !important;
            }

            .tmu-userinfo .tmu-name {
                font-size: 11px;
            }

            .tmu-badge {
                font-size: 10px;
                padding: 1px 8px;
            }

            .tmu-userinfo {
                text-align: left;
            }

            .tmu-nav-toggle {
                display: block;
            }

            .tmu-menu {
                display: none;
                flex-direction: column;
                padding: 0;
            }

                .tmu-menu.show {
                    display: flex;
                }

                .tmu-menu > li > a {
                    padding: 11px 18px;
                    border-top: 1px solid rgba(255,255,255,.2);
                }

            .tmu-sub {
                position: static;
                box-shadow: none;
                border-radius: 0;
                border-top: 0;
                background: #fff8ee;
            }

            .tmu-menu > li:hover > .tmu-sub {
                display: none;
            }

            .tmu-menu > li.open > .tmu-sub {
                display: block;
            }

            .tmu-content {
                padding: 12px;
            }

            .tmu-footer-in {
                flex-direction: column;
            }
        }
    </style>

    <script type="text/javascript">
        if (document.layers) {
            document.captureEvents(Event.MOUSEDOWN);
            document.onmousedown = function () {
                return false;
            };
        }
        else {
            document.onmouseup = function (e) {
                if (e != null && e.type == "mouseup") {
                    if (e.which == 2 || e.which == 3) {
                        return false;
                    }
                }
            };
        }
    </script>

    <script>
        function callFeedbackMessage(inputType, inputText) {

            if (inputType == 'Error') {
                alertify.error(inputText);
                return false;
            }
            else if (inputType == 'Success') {
                alertify.success(inputText);
                return false;
            }
            else {
                alertify.log(inputText, "", 10000);
                return false;
            }
        }
    </script>
    <script type="text/javascript">
        var av = document.querySelector('.tmu-avatar');
        if (av) {
            av.addEventListener('click', function () {
                av.style.transform = 'scale(1.12)';
                setTimeout(function () { av.style.transform = ''; }, 250);
            });
        }
    </script>
    <script type="text/javascript">
        var validFilesTypes = ["png", "jpg", "jpeg", "gif"];
        function ValidateFile() {
            var label;
            var path = $('[id$=imgUpload]').val();
            var ext = path.substring(path.lastIndexOf(".") + 1, path.length).toLowerCase();
            var isValidFile = false;
            for (var i = 0; i < validFilesTypes.length; i++) {
                if (ext == validFilesTypes[i]) {
                    isValidFile = true;
                }
            }
            if (!isValidFile) {

                label = "Invalid File. Please upload a File with" +
                    " extension:\n\n" + validFilesTypes.join(", ");
                alertify.error(label);
            }
            return isValidFile;
        }

        $(document).ready(function () {
            $('[id$=btnChangePassword]').click(function Save() {
                $('[id$=txtOldPassword]').val() == '';
                $('[id$=txtNewPassword]').val() == '';
                $('[id$=txtConfirmPassword]').val() == '';
                $('[id$=lblErrorMessage]').text('');
                var a = '', b = '', c = '';
                $('[id$=txtOldPassword]').css('border-color', 'red');
                if ($('[id$=txtOldPassword]').val() == '') { a = "false" } else $('[id$=txtOldPassword]').css('border-color', '');
                $('[id$=txtNewPassword]').css('border-color', 'red');
                if ($('[id$=txtNewPassword]').val() == '') { a = "false" } else $('[id$=txtNewPassword]').css('border-color', '');
                $('[id$=txtConfirmPassword]').css('border-color', 'red');
                if ($('[id$=txtConfirmPassword]').val() == '') { a = "false" } else $('[id$=txtConfirmPassword]').css('border-color', '');

                if ($('[id$=txtNewPassword]').val() != $('[id$=txtConfirmPassword]').val()) { b = "false" };

                if ($('[id$=txtNewPassword]').val().length < 5) { c = "false" };

                if (a == "false") { return false; }
                if (c == "false") {
                    $('[id$=lblErrorMessage]').text('Password must be at least 5 characters!');
                    return false;
                }
                if (b == "false") {
                    $('[id$=lblErrorMessage]').text('Password does not match the confirm password!');
                    return false;
                }

                var arr = { txtOldPassword: $('[id$=txtOldPassword]').val(), txtNewPassword: $('[id$=txtNewPassword]').val() };
                $.ajax({
                    type: "POST",
                    url: "MasterPageChanges.aspx/ChangePassword",
                    data: JSON.stringify(arr),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: ChangePassword,
                    error: function (xmlHttpRequest, textStatus, errorThrown) {
                        alert('Error');
                    }
                });
            });
        });
        function ChangePassword(data) {
            if (data.d == 'successfully') {
                alertify.success('Change password successfully');
            }
            else {
                alertify.error('Old Password in not correct');
            }
        }
    </script>


    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="tmu-body">
    <form id="form1" runat="server">
        <div class="tmu-wrap">

            <!-- Top strip -->
            <div class="tmu-topstrip">
